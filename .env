# =====================================================================
# CampusConnect environment configuration
# Copy to `.env` (same folder) and adjust. NEVER commit the real `.env`.
# =====================================================================

# --- PostgreSQL ------------------------------------------------------
# Any PostgreSQL 13+ server. If you have none installed, run
# `npm run db:local` which starts a real PostgreSQL on port 54329
# (binaries are downloaded by the `embedded-postgres` npm package).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/campusconnect

# Used only by the automated test suites. MUST be a different database:
# the tests drop and recreate it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/campusconnect_test

# --- API server ------------------------------------------------------
PORT=4000
NODE_ENV=development
# Origin of the React dev server (CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# --- Demo authentication (NOT production-grade) ----------------------
# Signing key for the session JWT. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bb1f66bb5dbf66b0c060226a7369517dba60ea86851f4173087c37e0da50f281076b9950d358dde54066b91529da8d70
# Session lifetime (jsonwebtoken syntax, e.g. 30m, 8h, 1d)
SESSION_TTL=8h

# Shared password for the synthetic demo student accounts (student_id DEMO*).
DEMO_STUDENT_PASSWORD=student@123
# Shared password for every row of the ADMIN table (login with admin email).
DEMO_ADMIN_PASSWORD=admin@123
# Optional: supply bcrypt hashes instead of plain values (take precedence).
# Generate with:  npm run hash-password --workspace backend -- "my-password"
# DEMO_STUDENT_PASSWORD_HASH=
# DEMO_ADMIN_PASSWORD_HASH=

# Comma-separated student_id prefixes that may sign in as students.
# Real roster students are NOT given logins by default.
DEMO_STUDENT_PREFIXES=DEMO

# --- File uploads ----------------------------------------------------
# Folder (relative to the project root) where uploaded documents are stored.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Development-only ------------------------------------------------
# `npm run db:reset:dev` refuses to run unless this is exactly "yes".
ALLOW_DB_RESET=no
