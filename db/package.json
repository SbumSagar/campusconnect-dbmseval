{
  "name": "@campusconnect/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CampusConnect PostgreSQL schema, migrations, import, seed, audit and database tests",
  "scripts": {
    "local": "tsx scripts/local-postgres.ts",
    "migrate": "tsx scripts/migrate.ts",
    "import": "tsx seed/import_students.ts",
    "seed": "tsx seed/seed.ts",
    "audit": "tsx scripts/audit.ts",
    "sql": "tsx scripts/sql.ts",
    "reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "embedded-postgres": "18.6.0-beta.19",
    "exceljs": "^4.4.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
